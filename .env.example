# ---------------------------------------------------------------------------
# LOGIN KEYS (Firebase)
#
# 1. Copy this file and rename the copy to:  .env
# 2. Paste the values from your Firebase project into it.
# 3. Never put the .env file on GitHub — it is already in .gitignore.
#
# Where to find these: firebase.google.com -> your project -> Project settings
# -> General -> Your apps -> Web app -> SDK setup and configuration -> Config
#
# Full instructions in README.md, section "Setting up login".
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
