# ---------------------------------------------------------------------------
# SUPPLYBASE PROJECTS API — ENVIRONMENT
#
# Copy this file to `.env` and fill it in. `.env` is gitignored and must never
# be committed. Every value here is read by application.yml at startup.
#
# These are environment variables, not a file Spring reads on its own. Either
# export them in your shell, set them in your IDE's run configuration, or use
# a tool like `direnv`. See README.md in this folder.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=supplybase
DB_USER=supplybase
DB_PASSWORD=

# --- JWT -------------------------------------------------------------------
# MUST be at least 32 characters, and MUST be changed for production.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# --- Google sign-in --------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client
# ID -> Web application. Add http://localhost:3000 to "Authorised JavaScript
# origins" (the frontend app only — the admin app never shows a Google
# button). The client id is public — it is sent to the browser — and this
# flow needs no client secret at all.
# The SAME value must also go in the frontend's .env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# --- Razorpay --------------------------------------------------------------
# Dashboard -> Settings -> API Keys. Use the rzp_test_ keys until you go live.
# KEY_ID is public and is sent to the browser. KEY_SECRET never leaves the
# server. WEBHOOK_SECRET is a separate value you choose when creating the
# webhook under Settings -> Webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Where the website runs (CORS) -----------------------------------------
# PATTERNS, not plain origins. [*] matches any port, which matters because
# both the frontend (normally :3000) and the admin app (normally :3001) move
# to the next free port whenever their usual one is still held by an old dev
# server — and a hard-coded port then rejects the browser with a 403 that
# shows up as "could not reach the server".
#
# In PRODUCTION replace this with your exact Vercel/custom-domain origins for
# BOTH frontend apps and no wildcard, for example:
#   CORS_ORIGINS=https://supplybase-projects.vercel.app,https://admin.supplybase.co.in,https://www.supplybase.co.in,https://supplybase.co.in
CORS_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]

# --- Email notifications (optional) ----------------------------------------
# Leave ENQUIRY_EMAIL blank to switch enquiry emails off entirely.
# For Gmail, MAIL_PASSWORD must be an App Password, not your account password.
ENQUIRY_EMAIL=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# --- Misc ------------------------------------------------------------------
SERVER_PORT=8080
LOG_LEVEL=INFO
