import { useEffect, useRef, useState } from 'react';
import './HeroSlider.css';

const slides = [
  {
    src: '/assets/home-slider/1.jpeg',
    alt: 'SupplyBase promotional banner 1',
  },
  {
    src: '/assets/home-slider/2.jpeg',
    alt: 'SupplyBase promotional banner 2',
  },
  {
    src: '/assets/home-slider/3.jpeg',
    alt: 'SupplyBase promotional banner 3',
  },
];

export default function HeroSlider() {
  const [active, setActive] = useState(0);
  const [hovered, setHovered] = useState(false);
  const [focused, setFocused] = useState(false);
  const [touching, setTouching] = useState(false);
  const [manualPause, setManualPause] = useState(false);
  const [reducedMotion, setReducedMotion] = useState(false);

  const touchStart = useRef(null);

  const paused =
    hovered ||
    focused ||
    touching ||
    manualPause ||
    reducedMotion;

  const move = (direction) => {
    setActive((current) =>
      (current + direction + slides.length) % slides.length
    );
  };

  useEffect(() => {
    const media = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    const update = () => setReducedMotion(media.matches);

    update();
    media.addEventListener('change', update);

    return () => {
      media.removeEventListener('change', update);
    };
  }, []);

  useEffect(() => {
    if (paused) return undefined;

    const timer = window.setInterval(() => {
      if (!document.hidden) {
        setActive((current) =>
          (current + 1) % slides.length
        );
      }
    }, 5000);

    return () => window.clearInterval(timer);
  }, [active, paused]);

  const finishTouch = (event) => {
    const start = touchStart.current;
    const touch = event.changedTouches[0];

    if (start && touch) {
      const dx = touch.clientX - start.x;
      const dy = touch.clientY - start.y;

      if (
        Math.abs(dx) > 50 &&
        Math.abs(dx) > Math.abs(dy)
      ) {
        move(dx < 0 ? 1 : -1);
      }
    }

    touchStart.current = null;
    setTouching(false);
  };

  return (
    <section
      className="sb-image-slider"
      role="region"
      aria-roledescription="carousel"
      aria-label="SupplyBase highlights"
      onMouseEnter={() => setHovered(true)}
      onMouseLeave={() => setHovered(false)}
      onFocusCapture={() => setFocused(true)}
      onBlurCapture={(event) => {
        if (!event.currentTarget.contains(event.relatedTarget)) {
          setFocused(false);
        }
      }}
      onKeyDown={(event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          move(-1);
        }

        if (event.key === 'ArrowRight') {
          event.preventDefault();
          move(1);
        }
      }}
    >
      <div
        className="sb-image-slider__viewport"
        onTouchStart={(event) => {
          const touch = event.touches[0];

          if (touch) {
            touchStart.current = {
              x: touch.clientX,
              y: touch.clientY,
            };
          }

          setTouching(true);
        }}
        onTouchEnd={finishTouch}
        onTouchCancel={() => {
          touchStart.current = null;
          setTouching(false);
        }}
      >
        <div
          className="sb-image-slider__track"
          style={{
            transform: `translateX(-${active * 100}%)`,
          }}
          aria-live={paused ? 'polite' : 'off'}
        >
          {slides.map((slide, index) => (
            <div
              key={slide.src}
              className="sb-image-slider__slide"
              role="group"
              aria-roledescription="slide"
              aria-label={`${index + 1} of ${slides.length}`}
              aria-hidden={active !== index}
            >
              <img
                src={slide.src}
                alt={slide.alt}
                loading="eager"
                fetchpriority={index === 0 ? 'high' : 'auto'}
                decoding="async"
                draggable={false}
              />
            </div>
          ))}
        </div>

        <button
          type="button"
          className="sb-image-slider__arrow sb-image-slider__arrow--previous"
          aria-label="Previous banner"
          onClick={() => move(-1)}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m15 5-7 7 7 7" />
          </svg>
        </button>

        <button
          type="button"
          className="sb-image-slider__arrow sb-image-slider__arrow--next"
          aria-label="Next banner"
          onClick={() => move(1)}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m9 5 7 7-7 7" />
          </svg>
        </button>
      </div>

      <div className="sb-image-slider__controls">
        <div
          className="sb-image-slider__dots"
          aria-label="Choose banner"
        >
          {slides.map((slide, index) => (
            <button
              key={slide.src}
              type="button"
              className={`sb-image-slider__dot ${
                active === index ? 'is-active' : ''
              }`}
              aria-label={`Show banner ${index + 1}`}
              aria-current={
                active === index ? 'true' : undefined
              }
              onClick={() => setActive(index)}
            />
          ))}
        </div>

        {!reducedMotion && (
          <button
            type="button"
            className="sb-image-slider__pause"
            aria-label={
              manualPause
                ? 'Resume automatic sliding'
                : 'Pause automatic sliding'
            }
            onClick={() => {
              setManualPause((current) => !current);
            }}
          >
            {manualPause ? 'Play' : 'Pause'}
          </button>
        )}
      </div>
    </section>
  );
}