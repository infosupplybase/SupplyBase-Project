/* Full-width artwork in its original proportions */
.page-home .sb-final-banner {
  position: relative;
  display: block;
  width: 100%;
  margin: 0;
  padding: 0;
  isolation: isolate;
}

.sb-final-banner__images {
  position: relative;
  width: 100%;
  aspect-ratio: var(--banner-ratio);
  overflow: hidden;
  touch-action: pan-y;
}

.page-home .sb-final-banner .sb-final-banner__image {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: auto;
  max-width: none;
  margin: 0;
  padding: 0;
  opacity: 0;
  visibility: hidden;
  transform: none;
  transition: opacity 350ms ease;
  user-select: none;
}

.page-home .sb-final-banner .sb-final-banner__image.is-active {
  opacity: 1;
  visibility: visible;
}

/* Search fits below the artwork's text */
.sb-final-banner__search {
  position: absolute;
  left: 5%;
  bottom: 8%;
  z-index: 5;
  width: 31%;
  max-width: 640px;
}

.sb-final-banner .sb-restored-search,
.sb-final-banner .sb-restored-search__inner {
  position: static;
  display: block;
  width: 100%;
  max-width: none;
  height: auto;
  min-height: 0;
  margin: 0;
  padding: 0;
  background: transparent;
}

.sb-final-banner .sb-restored-search .home-search {
  position: relative;
  display: flex;
  align-items: center;
  gap: 0;
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 0 16px;
  border: 1px solid transparent;
  border-radius: 999px;
  background: #fff;
  color: #252525;
  box-shadow: 0 4px 18px rgba(0, 0, 0, .14);
  opacity: 1;
  visibility: visible;
  transform: none;
  animation: none;
}

.sb-final-banner .home-search .home-search-icon {
  position: static;
  flex: 0 0 18px;
  width: 18px;
  height: 18px;
  margin: 0;
  color: #777;
  transform: none;
}

.sb-final-banner .home-search input,
.sb-final-banner .home-search input:focus,
.sb-final-banner .home-search input:focus-visible {
  position: static !important;
  display: block;
  flex: 1 1 0%;
  width: 0;
  min-width: 0;
  height: clamp(42px, 4vw, 58px);
  margin: 0 !important;
  padding: 0 0 0 10px !important;
  border: 0 !important;
  border-radius: 0 !important;
  outline: none !important;
  box-shadow: none !important;
  background: transparent !important;
  color: #252525;
  font: inherit;
  font-size: clamp(12px, 1vw, 15px);
  transform: none;
}

.sb-final-banner .home-search:focus-within {
  border-color: #b58b28;
  box-shadow: 0 0 0 3px rgba(181, 139, 40, .2);
}

.sb-final-banner .home-search-results {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  right: 0;
  z-index: 20;
  max-height: 300px;
  overflow-y: auto;
  padding: 6px;
  border: 1px solid #e5e5e5;
  border-radius: 12px;
  background: #fff;
  color: #252525;
  box-shadow: 0 8px 24px rgba(0, 0, 0, .15);
}

.sb-final-banner .home-search-result {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 12px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #252525;
  text-align: left;
  cursor: pointer;
}

.sb-final-banner .home-search-result:hover {
  background: #fff8e9;
}

.sb-final-banner .home-search-result strong,
.sb-final-banner .home-search-result small {
  display: block;
}

.sb-final-banner .home-search-result small {
  margin-top: 3px;
  color: #666;
}

.sb-final-banner .home-search-status {
  margin: 0;
  padding: 12px;
  color: #666;
}

.sb-final-banner .home-search-status.error {
  color: #b42318;
}

/* Dots stay on the artwork */
.sb-final-banner__dots {
  position: absolute;
  bottom: 8px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;
  display: flex;
  gap: 2px;
  padding: 0 4px;
  border-radius: 999px;
  background: rgba(0, 0, 0, .25);
}

.sb-final-banner__dots button {
  display: grid;
  place-items: center;
  width: 26px;
  height: 26px;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
}

.sb-final-banner__dots button::before {
  content: '';
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: rgba(255, 255, 255, .65);
}

.sb-final-banner__dots button.is-active::before {
  width: 18px;
  background: #e6b638;
}

.sb-final-banner__dots button:focus-visible {
  outline: 2px solid #e6b638;
  outline-offset: 1px;
}

/* Keep desktop artwork complete on small screens.
   Search sits beneath it until mobile banners are supplied. */
@media (max-width: 767px) {
  .sb-final-banner__search {
    position: relative;
    left: auto;
    bottom: auto;
    width: auto;
    max-width: none;
    margin: 0;
    padding: 12px 16px;
    background: #fff;
  }

  .sb-final-banner .home-search input {
    height: 46px;
    font-size: 13px;
  }

  .sb-final-banner__dots {
    top: calc(var(--image-height) - 28px);
    bottom: auto;
    background: rgba(0, 0, 0, .35);
  }
}

@media (prefers-reduced-motion: reduce) {
  .sb-final-banner__image {
    transition: none;
  }
}
/* Smaller gap above Popular Services */
.page-home > .sb-final-banner + * {
  margin-top: 0 !important;
  padding-top: 32px !important;
}

@media (max-width: 767px) {
  .page-home > .sb-final-banner + * {
    padding-top: 24px !important;
  }
}
/* Mobile banners with complete artwork */
.page-home .sb-final-banner picture.sb-final-banner__image {
  height: 100%;
}

.page-home .sb-final-banner picture.sb-final-banner__image img {
  position: static !important;
  display: block !important;
  width: 100% !important;
  height: auto !important;
  max-width: none !important;
  max-height: none !important;
  margin: 0 !important;
  padding: 0 !important;
  object-fit: contain !important;
  transform: none !important;
}

@media (max-width: 767px) {
  .page-home .sb-final-banner__images {
    aspect-ratio: var(--mobile-banner-ratio) !important;
  }

  .page-home .sb-final-banner__search {
    position: absolute !important;
    left: 5% !important;
    right: auto !important;
    top: auto !important;
    bottom: 12% !important;
    width: 90% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    background: transparent !important;
  }

  .page-home .sb-final-banner .sb-restored-search,
  .page-home .sb-final-banner .sb-restored-search__inner {
    position: static !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    background: transparent !important;
  }

  .page-home .sb-final-banner .home-search {
    padding: 0 14px;
    border-radius: 999px;
    background: #fff;
  }

  .page-home .sb-final-banner .home-search input {
    height: 44px !important;
    font-size: 12px !important;
  }

  .page-home .sb-final-banner .home-search .home-search-icon {
    flex-basis: 17px;
    width: 17px;
    height: 17px;
  }

  .page-home .sb-final-banner__dots {
    top: auto !important;
    bottom: 6px !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
  }

  .page-home .sb-final-banner__dots button {
    width: 26px;
    height: 24px;
  }
}
/* Horizontal sliding instead of fading */
.page-home .sb-final-banner .sb-final-banner__track {
  display: flex;
  align-items: flex-start;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  transition: transform 500ms cubic-bezier(.22, .61, .36, 1);
}

.page-home .sb-final-banner .sb-final-banner__track
picture.sb-final-banner__image {
  position: relative !important;
  inset: auto !important;
  display: block !important;
  flex: 0 0 100% !important;
  width: 100% !important;
  min-width: 0 !important;
  height: auto !important;
  margin: 0 !important;
  padding: 0 !important;
  opacity: 1 !important;
  visibility: visible !important;
  transform: none !important;
  transition: none !important;
}

@media (prefers-reduced-motion: reduce) {
  .page-home .sb-final-banner .sb-final-banner__track {
    transition: none;
  }
}