.sb-image-slider {
  position: relative;
  width: 100%;
  margin: 0;
  padding: 0;
  background: #fff;
}

.sb-image-slider__viewport {
  position: relative;
  width: 100%;
  overflow: hidden;
  touch-action: pan-y;
}

.sb-image-slider__track {
  display: flex;
  align-items: flex-start;
  width: 100%;
  transition: transform 550ms cubic-bezier(.22, .61, .36, 1);
}

.sb-image-slider__slide {
  flex: 0 0 100%;
  min-width: 0;
}

.sb-image-slider__slide img {
  display: block;
  width: 100%;
  height: auto;
  margin: 0;
  user-select: none;
}

.sb-image-slider__controls {
  position: absolute;
  bottom: 14px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 6px;
  border-radius: 999px;
  background: rgba(255, 255, 255, .85);
}

.sb-image-slider__dots {
  display: flex;
  align-items: center;
  gap: 3px;
}

.sb-image-slider__dot {
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  cursor: pointer;
}

.sb-image-slider__dot::before {
  content: '';
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: #aaa;
  transition: width 200ms ease, background 200ms ease;
}

.sb-image-slider__dot.is-active::before {
  width: 20px;
  background: #b58b28;
}

.sb-image-slider__dot:focus-visible {
  outline: 2px solid #b58b28;
  outline-offset: 2px;
}

/* Search uses explicit styles independent of the old hero layout. */
.sb-restored-search {
  position: relative;
  z-index: 5;
  display: block;
  width: 100%;
  padding: 16px;
  background: #fff;
}

.sb-restored-search__inner {
  width: 100%;
  max-width: 640px;
  margin: 0 auto;
}

.sb-restored-search .home-search {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 0;
  border: 1px solid #dedede;
  border-radius: 12px;
  background: #fff;
  color: #252525;
  opacity: 1;
  visibility: visible;
  transform: none;
  animation: none;
  box-shadow: 0 3px 12px rgba(0, 0, 0, .05);
}

.sb-restored-search .home-search-icon {
  position: static;
  flex-shrink: 0;
  margin-left: 16px;
  color: #9a7625;
  transform: none;
}

.sb-restored-search .home-search input {
  display: block;
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 52px;
  margin: 0;
  padding: 0 14px;
  border: 0;
  outline: none;
  border-radius: 12px;
  background: transparent;
  color: #252525;
  font: inherit;
  font-size: 15px;
  opacity: 1;
  visibility: visible;
}

.sb-restored-search .home-search:focus-within {
  border-color: #b58b28;
  box-shadow: 0 0 0 3px rgba(181, 139, 40, .12);
}

.sb-restored-search .home-search-results {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  right: 0;
  z-index: 50;
  max-height: 320px;
  overflow-y: auto;
  padding: 6px;
  border: 1px solid #e5e5e5;
  border-radius: 12px;
  background: #fff;
  color: #252525;
  box-shadow: 0 8px 24px rgba(0, 0, 0, .12);
}

.sb-restored-search .home-search-result {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 12px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #252525;
  text-align: left;
  cursor: pointer;
}

.sb-restored-search .home-search-result:hover {
  background: #fff8e9;
}

.sb-restored-search .home-search-result strong,
.sb-restored-search .home-search-result small {
  display: block;
}

.sb-restored-search .home-search-result small {
  margin-top: 3px;
  color: #666;
}

.sb-restored-search .home-search-status {
  margin: 0;
  padding: 12px;
  color: #666;
}

.sb-restored-search .home-search-status.error {
  color: #b42318;
}

@media (max-width: 600px) {
  .sb-image-slider__controls {
    bottom: 6px;
  }

  .sb-restored-search {
    padding: 12px;
  }

  .sb-restored-search .home-search input {
    height: 48px;
    font-size: 13px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .sb-image-slider__track,
  .sb-image-slider__dot::before {
    transition: none;
  }
}