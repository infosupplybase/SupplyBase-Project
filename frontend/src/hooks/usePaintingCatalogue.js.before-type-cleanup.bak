import { useEffect, useMemo, useState } from 'react';
import api, { friendlyError } from '../lib/api';

let cachedForm = null;
let pendingRequest = null;

function loadPaintingForm() {
  if (cachedForm) {
    return Promise.resolve(cachedForm);
  }

  if (!pendingRequest) {
    pendingRequest = api.serviceForm('painting')
      .then((result) => {
        cachedForm = result;
        return result;
      })
      .finally(() => {
        pendingRequest = null;
      });
  }

  return pendingRequest;
}

export default function usePaintingCatalogue() {
  const [form, setForm] = useState(() => cachedForm);
  const [loading, setLoading] = useState(() => !cachedForm);
  const [error, setError] = useState('');

  useEffect(() => {
    let cancelled = false;

    loadPaintingForm()
      .then((result) => {
        if (cancelled) return;
        setForm(result);
        setError('');
      })
      .catch((err) => {
        if (!cancelled) {
          setError(friendlyError(err));
        }
      })
      .finally(() => {
        if (!cancelled) {
          setLoading(false);
        }
      });

    return () => {
      cancelled = true;
    };
  }, []);

  const byKey = useMemo(() => {
    const map = new Map();

    (form?.questions || []).forEach((question) => {
      map.set(question.key, question);
    });

    return map;
  }, [form]);

  const optionsFor = (questionKey) => {
    const options = byKey.get(questionKey)?.options || [];

    const isPaintingType =
      questionKey === 'full_home_painting_type' ||
      questionKey === 'few_walls_painting_type';

    if (!isPaintingType) return options;

    return options
      .filter((option) =>
        ['standard-repaint', 'renovation-painting'].includes(option.value)
      )
      .map((option) => {
        if (option.value === 'standard-repaint') {
          return {
            ...option,
            label: 'Unfurnished Home',
            hint: 'For an empty home without furniture.',
          };
        }

        return {
          ...option,
          label: 'Renovation Painting',
          hint: 'For repainting existing or damaged walls.',
        };
      });
  };

  const productsByTier = (questionKey) => {
    const byTier = new Map();
    const sharedQuestions = [
      'full_home_product',
      'few_walls_product',
    ];

    const options = sharedQuestions.includes(questionKey)
      ? sharedQuestions.flatMap((key) => optionsFor(key))
      : optionsFor(questionKey);

    const seen = new Set();

    options.forEach((option) => {
      if (seen.has(option.value)) return;
      seen.add(option.value);

      const tier = option.group || 'Premium';

      if (!byTier.has(tier)) {
        byTier.set(tier, []);
      }

      byTier.get(tier).push(option);
    });

    return byTier;
  };

  const coloursByTab = (questionKey) => {
    const byTab = new Map();

    optionsFor(questionKey).forEach((option) => {
      const tab = option.group || 'Popular';

      if (!byTab.has(tab)) {
        byTab.set(tab, []);
      }

      byTab.get(tab).push({
        ...option,
        hex: option.hint || '#E5E5E5',
      });
    });

    return byTab;
  };

  return {
    category: form?.category,
    loading,
    error,
    optionsFor,
    productsByTier,
    coloursByTab,
  };
}