# ---------------------------------------------------------------------------
# WEBSITE ENVIRONMENT
#
# 1. Copy this file and rename the copy to: .env.local
# 2. Fill in the values.
# 3. Never put .env.local on GitHub — it is already in .gitignore.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the JavaScript the browser
# downloads, so treat every value here as PUBLIC. Nothing secret belongs in
# this file — secrets live in backend/.env, which is never sent to a browser.
# ---------------------------------------------------------------------------

# --- Where the API lives ---------------------------------------------------
# Leave as-is for local development. In Vercel set this in Project Settings ->
# Environment Variables to your Render/Railway API address, for example
# https://supplybase-api.onrender.com. Do not include a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Google sign-in (optional) ---------------------------------------------
# The OAuth client id from Google Cloud Console:
#   APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#   -> Web application
#   -> Authorised JavaScript origins: http://localhost:3000 (and your live
#      domain when you deploy)
#
# This MUST be the same value as GOOGLE_CLIENT_ID in backend/.env — the
# backend checks that a token was issued for this exact client id, and a
# mismatch means every Google sign-in is rejected.
#
# Leave blank and the Google button simply does not appear; email and password
# sign-in works either way.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Where the admin app lives ----------------------------------------------
# A signed-in ADMIN who lands on /dashboard is sent here instead — the admin
# panel is a separate app, not a route inside this one.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
